# =============================================================================
# Public base URL of this deployment (no trailing slash).
# Used for canonical URLs, OpenGraph tags, robots.txt and sitemap.xml.
#
# On Vercel this is derived automatically from VERCEL_PROJECT_PRODUCTION_URL
# when unset, but setting it explicitly guarantees stable canonical URLs.
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://example.com

# =============================================================================
# Base URL of the data API that backs this app.
#
# Leave empty (default) to use the built-in Next.js route handlers under /api
# (same origin) — the local/preview BFF seeded from the core_engine model.
# Set this to the deployed Rust core-engine API to switch backends without any
# code change, e.g. https://api.abecca.internal
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=

# =============================================================================
# Base URL of the clinical portal (abecca_main) whose device fleet this IT
# console monitors. When set, the Device Fleet page reads its /api/devices.
# Leave empty to show a representative fallback snapshot.
# e.g. https://abecca-main.vercel.app
# =============================================================================
NEXT_PUBLIC_MAIN_API_URL=
