# =============================================================================
# Public base URL of this deployment (no trailing slash).
# Used for canonical URLs, OpenGraph tags, robots.txt and sitemap.xml.
#
# On Vercel this is derived automatically from VERCEL_PROJECT_PRODUCTION_URL
# when unset, but setting it explicitly guarantees stable canonical URLs.
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://example.com

# =============================================================================
# Base URL of the data API that backs this app.
#
# Leave empty (default) to use the built-in Next.js route handlers under /api
# (same origin) — the local/preview BFF seeded from the core_engine model.
# Set this to the deployed Rust core-engine API to switch backends without any
# code change, e.g. https://api.abecca.internal
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=

# =============================================================================
# Optional shared secret for the on-prem device gateway (legacy RS-232/HL7/
# DICOM hardware). When set, POST /api/devices/ingest requires the matching
# x-gateway-token header. Leave empty in preview/dev.
# =============================================================================
GATEWAY_INGEST_TOKEN=

# =============================================================================
# Supabase persistence (server-only). When BOTH are set, the BFF route handlers
# read and write Supabase instead of the built-in in-memory store; leave them
# empty to use the in-memory store (seeded, resets on restart — fine for
# preview/dev). Switching backends needs no code change.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security and must stay
# server-side. It is intentionally NOT prefixed with NEXT_PUBLIC_, so Next.js
# never inlines it into a client bundle. Set both in your host's environment
# (e.g. Vercel project settings) — never commit real values.
# =============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
